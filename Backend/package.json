{
  "name": "expensemate-backend",
  "version": "1.0.0",
  "description": "ExpenseMate - Personal Expense Manager REST API (Node.js + Express + MySQL, layered: Controller -> Service -> Repository)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:down": "node scripts/migrate.js down",
    "db:init": "node scripts/migrate.js up",
    "migrate:verify": "node scripts/verify-migration.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/system/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:system": "node --test --test-concurrency=1 \"tests/system/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/system/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "mysql-memory-server": "1.17.0",
    "supertest": "7.1.4"
  }
}
